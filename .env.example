# Stable defaults
IOS_SIM_ENABLE_DRIVE_MODE=1
IOS_SIM_ENABLE_EXPERIMENTAL=0
IOS_SIM_ENABLE_DRIVE_TESTING=0
IOS_SIM_ENABLE_WIRELESS_TESTING=0
VITE_ENABLE_DRIVE_MODE=1
VITE_ENABLE_EXPERIMENTAL_FEATURES=0
VITE_ENABLE_DRIVE_TESTING=0
VITE_ENABLE_WIRELESS_TESTING=0

# Drive Mode is stable and always available. Drive Testing Lab requires all four:
# IOS_SIM_ENABLE_EXPERIMENTAL=1
# IOS_SIM_ENABLE_DRIVE_TESTING=1
# VITE_ENABLE_EXPERIMENTAL_FEATURES=1
# VITE_ENABLE_DRIVE_TESTING=1

# Wireless Testing Lab requires the generic experimental flags plus both wireless
# flags. It is separate from Drive Testing:
# IOS_SIM_ENABLE_EXPERIMENTAL=1
# IOS_SIM_ENABLE_WIRELESS_TESTING=1
# VITE_ENABLE_EXPERIMENTAL_FEATURES=1
# VITE_ENABLE_WIRELESS_TESTING=1
