+/// Establishes the three DTX connections required for XCTest using an already
+/// established RSD adapter and handshake.
+async fn connect_testmanagerd_supplied_rsd<S: XCUITestStageListener>(
+    mut handle: crate::tcp::handle::AdapterHandle,
+    handshake: RsdHandshake,
+    stage_listener: &mut S,
+) -> Result<TestManagerConnections, IdeviceError> {
+    validate_required_rsd_services(&handshake)?;
+    stage_listener
+        .xctest_stage_changed(XCUITestStartupStage::RsdReady)
+        .await?;
+
+    let ctrl = rsd_connect(
+        &mut handle,
+        &handshake,
+        TESTMANAGERD_RSD_SERVICE,
+        "testmanagerd-ctrl",
+        false,
+    )
+    .await?;
+    stage_listener
+        .xctest_stage_changed(XCUITestStartupStage::TestmanagerControlReady)
+        .await?;
+
+    let main = rsd_connect(
+        &mut handle,
+        &handshake,
+        TESTMANAGERD_RSD_SERVICE,
+        "testmanagerd-main",
+        false,
+    )
+    .await?;
+    stage_listener
+        .xctest_stage_changed(XCUITestStartupStage::TestmanagerMainReady)
+        .await?;
+
+    let dvt = rsd_connect(
+        &mut handle,
+        &handshake,
+        "com.apple.instruments.dtservicehub",
+        "dtservicehub",
+        true,
+    )
+    .await?;
+    stage_listener
+        .xctest_stage_changed(XCUITestStartupStage::DvtReady)
+        .await?;
+
+    Ok(TestManagerConnections {
+        ctrl,
+        main,
+        dvt,
+        rsd_handles: vec![handle],
+    })
+}
