+/// Startup milestones reached while an XCTest runner is being orchestrated.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum XCUITestStartupStage {
+    RsdReady,
+    TestmanagerControlReady,
+    TestmanagerMainReady,
+    DvtReady,
+    RunnerLaunched,
+    PidAuthorized,
+    XctestHandshakeReady,
+    TestPlanStarted,
+    Finished,
+}
+
+/// Callback interface for coarse XCTest startup state.
