+async fn create_rppairing_tunnel(
+    pairing: &mut RpPairingFile,
+    addr: SocketAddr,
+    hostname: &str,
+) -> Result<(idevice::tcp::handle::AdapterHandle, RsdHandshake), IdeviceError> {
+    let stream = tokio::net::TcpStream::connect(addr).await?;
+    let conn = RpPairingSocket::new(stream);
+    let mut rpc = RemotePairingClient::new(conn, hostname);
+    rpc.connect(pairing, || async { "000000".to_owned() })
+        .await?;
+
+    let tunnel_port = rpc.create_tcp_listener().await?;
+    let mut tunnel_addr = addr;
+    tunnel_addr.set_port(tunnel_port);
+    let tunnel_stream = tokio::net::TcpStream::connect(tunnel_addr).await?;
+    let tunnel = connect_tls_psk_tunnel_native(tunnel_stream, rpc.encryption_key()).await?;
+
+    let client_ip = tunnel
+        .info
+        .client_address
+        .parse()
+        .map_err(|e| IdeviceError::InternalError(format!("{e}")))?;
+    let server_ip = tunnel
+        .info
+        .server_address
+        .parse()
+        .map_err(|e| IdeviceError::InternalError(format!("{e}")))?;
+    let mtu = tunnel.info.mtu as usize;
+    let rsd_port = tunnel.info.server_rsd_port;
+
+    let raw = tunnel.into_inner();
+    let mut adapter = idevice::tcp::adapter::Adapter::new(Box::new(raw), client_ip, server_ip);
+    adapter.set_mss(mtu.saturating_sub(60));
+    let mut adapter = adapter.to_async_handle();
+
+    let rsd_stream = adapter
+        .connect(rsd_port)
+        .await
+        .map_err(|e| IdeviceError::InternalError(format!("{e}")))?;
+    let handshake = RsdHandshake::new(rsd_stream).await?;
+    Ok((adapter, handshake))
+}
+
+fn parse_args() -> Result<Args, Box<dyn std::error::Error>> {
+    let mut values: HashMap<String, Vec<String>> = HashMap::new();
+    let mut iter = std::env::args().skip(1);
+    while let Some(arg) = iter.next() {
+        if arg == "--help" || arg == "-h" {
+            print_usage();
+            std::process::exit(0);
+        }
+        if !arg.starts_with("--") {
+            return Err(format!("unexpected argument {arg:?}").into());
+        }
+        let key = arg.trim_start_matches("--").to_owned();
+        let value = iter
+            .next()
+            .ok_or_else(|| format!("missing value for --{key}"))?;
+        values.entry(key).or_default().push(value);
+    }
+
+    Ok(Args {
+        host: take_required(&mut values, "host")?,
+        port: take_optional(&mut values, "port")?.unwrap_or(58783),
+        pairing: take_required(&mut values, "pairing")?,
+        hostname: take_optional(&mut values, "hostname")?.unwrap_or_else(|| "IOSSimGate2".into()),
+        ios_major: take_optional(&mut values, "ios-major")?.unwrap_or(17),
+        runner_bundle_id: take_required(&mut values, "runner-bundle-id")?,
+        runner_app_path: take_required(&mut values, "runner-app-path")?,
+        runner_app_container: take_required(&mut values, "runner-app-container")?,
+        runner_bundle_executable: take_required(&mut values, "runner-bundle-executable")?,
+        timeout_seconds: take_optional(&mut values, "timeout-seconds")?,
+        env: values.remove("env").unwrap_or_default(),
+    })
+}
+
+fn take_required(
+    values: &mut HashMap<String, Vec<String>>,
+    key: &str,
+) -> Result<String, Box<dyn std::error::Error>> {
+    take_optional(values, key)?.ok_or_else(|| format!("missing --{key}").into())
+}
+
+fn take_optional<T: std::str::FromStr>(
+    values: &mut HashMap<String, Vec<String>>,
+    key: &str,
+) -> Result<Option<T>, Box<dyn std::error::Error>>
+where
+    T::Err: std::error::Error + 'static,
+{
+    let Some(mut raw) = values.remove(key) else {
+        return Ok(None);
+    };
+    if raw.len() != 1 {
+        return Err(format!("--{key} may only be provided once").into());
+    }
+    Ok(Some(raw.remove(0).parse()?))
+}
+
+fn print_usage() {
+    println!(
+        "Usage: xctest_supplied_rsd --host IP --pairing RPPairing.plist \\
+         --runner-bundle-id ID --runner-app-path PATH --runner-app-container PATH \\
+         --runner-bundle-executable NAME [--port 58783] [--ios-major 17] \\
+         [--hostname IOSSimGate2] [--timeout-seconds 60] [--env KEY=VALUE]"
+    );
+}
