+#[tokio::main]
+async fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let args = parse_args()?;
+    let addr: SocketAddr = format!("{}:{}", args.host, args.port).parse()?;
+
+    println!("Gate 2 harness: creating caller-owned RPPairing tunnel/RSD");
+    let mut pairing = RpPairingFile::read_from_file(&args.pairing).await?;
+    let (adapter, handshake) = create_rppairing_tunnel(&mut pairing, addr, &args.hostname).await?;
+    println!(
