+//! Minimal XCTest runner FFI.
+
+use std::{
+    ffi::{CStr, CString, c_char, c_void},
+    ptr::null_mut,
+    sync::{Arc, Mutex},
+    time::Duration,
+};
+
+use idevice::{
+    IdeviceError, RsdService as _,
+    installation_proxy::InstallationProxyClient,
+    services::dvt::xctest::{
+        TestConfig, XCUITestService, XCUITestStageListener, XCUITestStartupStage,
+        listener::XCUITestListener, validate_required_rsd_services,
+    },
+};
+use plist::{Dictionary, Value};
+use tokio::task::JoinHandle;
+
+use crate::{IdeviceFfiError, core_device_proxy::AdapterHandle, ffi_err, rsd::RsdHandshakeHandle};
+
+#[repr(C)]
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum XCTestRunnerStatus {
+    Unknown = 0,
+    RsdReady = 1,
+    TestmanagerControlReady = 2,
+    TestmanagerMainReady = 3,
+    DvtReady = 4,
+    RunnerLaunched = 5,
+    PidAuthorized = 6,
+    XctestHandshakeReady = 7,
+    TestPlanStarted = 8,
+    Finished = 9,
+    Failed = 10,
+}
+
+#[repr(C)]
+pub struct XCTestRunnerConfig {
+    pub runner_bundle_id: *const c_char,
+    pub runner_app_path: *const c_char,
+    pub runner_app_container: *const c_char,
+    pub runner_bundle_executable: *const c_char,
+    pub target_bundle_id: *const c_char,
+    pub target_app_path: *const c_char,
+    pub env_vars: *const *const c_char,
+    pub env_vars_count: usize,
+    pub arguments: *const *const c_char,
+    pub arguments_count: usize,
+}
+
+#[repr(C)]
+pub struct XCTestRunnerMetadata {
+    pub runner_bundle_id: *mut c_char,
+    pub runner_app_path: *mut c_char,
+    pub runner_app_container: *mut c_char,
+    pub runner_bundle_executable: *mut c_char,
+}
+
+pub type XCTestRunnerStatusCallback = Option<
+    unsafe extern "C" fn(context: *mut c_void, status: XCTestRunnerStatus, message: *const c_char),
+>;
+
+#[derive(Debug)]
+struct XCTestRunnerSharedState {
+    status: XCTestRunnerStatus,
+    first_error_stage: XCTestRunnerStatus,
+    error_message: Option<String>,
+}
+
+pub struct XCTestRunnerHandle {
+    source: idevice::services::dvt::xctest::XCUITestRsdConnection,
+    state: Arc<Mutex<XCTestRunnerSharedState>>,
+    task: Mutex<Option<JoinHandle<()>>>,
+    callback: XCTestRunnerStatusCallback,
+    callback_context: usize,
+}
+
+struct FfiXCTestListener;
+
+impl XCUITestListener for FfiXCTestListener {}
+
+struct FfiXCTestStageListener {
+    state: Arc<Mutex<XCTestRunnerSharedState>>,
+    callback: XCTestRunnerStatusCallback,
+    callback_context: usize,
+}
+
+impl FfiXCTestStageListener {
+    fn set_status(&self, status: XCTestRunnerStatus, message: Option<String>) {
+        {
+            let mut state = self.state.lock().expect("xctest runner state poisoned");
+            state.status = status;
+            if status == XCTestRunnerStatus::Failed
+                && state.first_error_stage == XCTestRunnerStatus::Unknown
+            {
+                state.first_error_stage = next_error_stage(state.status);
+            }
+            if let Some(message) = message.as_ref() {
+                state.error_message = Some(message.clone());
+            }
+        }
+        notify(
+            self.callback,
+            self.callback_context,
+            status,
+            message.as_deref(),
+        );
+    }
+}
+
+impl XCUITestStageListener for FfiXCTestStageListener {
+    async fn xctest_stage_changed(
+        &mut self,
+        stage: XCUITestStartupStage,
+    ) -> Result<(), IdeviceError> {
+        self.set_status(stage.into(), None);
+        Ok(())
+    }
+}
+
+impl From<XCUITestStartupStage> for XCTestRunnerStatus {
+    fn from(stage: XCUITestStartupStage) -> Self {
+        match stage {
+            XCUITestStartupStage::RsdReady => Self::RsdReady,
+            XCUITestStartupStage::TestmanagerControlReady => Self::TestmanagerControlReady,
+            XCUITestStartupStage::TestmanagerMainReady => Self::TestmanagerMainReady,
+            XCUITestStartupStage::DvtReady => Self::DvtReady,
+            XCUITestStartupStage::RunnerLaunched => Self::RunnerLaunched,
+            XCUITestStartupStage::PidAuthorized => Self::PidAuthorized,
+            XCUITestStartupStage::XctestHandshakeReady => Self::XctestHandshakeReady,
+            XCUITestStartupStage::TestPlanStarted => Self::TestPlanStarted,
+            XCUITestStartupStage::Finished => Self::Finished,
+        }
+    }
+}
+
+fn next_error_stage(status: XCTestRunnerStatus) -> XCTestRunnerStatus {
+    match status {
+        XCTestRunnerStatus::Unknown => XCTestRunnerStatus::RsdReady,
+        XCTestRunnerStatus::RsdReady => XCTestRunnerStatus::TestmanagerControlReady,
+        XCTestRunnerStatus::TestmanagerControlReady => XCTestRunnerStatus::TestmanagerMainReady,
+        XCTestRunnerStatus::TestmanagerMainReady => XCTestRunnerStatus::DvtReady,
+        XCTestRunnerStatus::DvtReady => XCTestRunnerStatus::RunnerLaunched,
+        XCTestRunnerStatus::RunnerLaunched => XCTestRunnerStatus::PidAuthorized,
+        XCTestRunnerStatus::PidAuthorized => XCTestRunnerStatus::XctestHandshakeReady,
+        XCTestRunnerStatus::XctestHandshakeReady => XCTestRunnerStatus::TestPlanStarted,
+        XCTestRunnerStatus::TestPlanStarted => XCTestRunnerStatus::Finished,
+        XCTestRunnerStatus::Finished | XCTestRunnerStatus::Failed => status,
+    }
+}
+
+fn set_failure(
+    state: &Arc<Mutex<XCTestRunnerSharedState>>,
+    callback: XCTestRunnerStatusCallback,
+    callback_context: usize,
+    error: IdeviceError,
+) {
+    let message = format!("{error:?}");
+    let error_stage = {
+        let mut state = state.lock().expect("xctest runner state poisoned");
+        let error_stage = next_error_stage(state.status);
+        state.status = XCTestRunnerStatus::Failed;
+        if state.first_error_stage == XCTestRunnerStatus::Unknown {
+            state.first_error_stage = error_stage;
+        }
+        state.error_message = Some(message.clone());
+        state.first_error_stage
+    };
+    notify(
+        callback,
+        callback_context,
+        XCTestRunnerStatus::Failed,
+        Some(&format!("{error_stage:?}: {message}")),
+    );
+}
+
+fn notify(
+    callback: XCTestRunnerStatusCallback,
+    callback_context: usize,
+    status: XCTestRunnerStatus,
+    message: Option<&str>,
+) {
+    if let Some(callback) = callback {
+        let message = CString::new(message.unwrap_or(""))
+            .unwrap_or_else(|_| CString::new("invalid status message").unwrap());
+        unsafe { callback(callback_context as *mut c_void, status, message.as_ptr()) };
+    }
+}
+
+fn metadata_from_config(cfg: TestConfig) -> Result<XCTestRunnerMetadata, IdeviceError> {
+    let runner_bundle_id =
+        CString::new(cfg.runner_bundle_id).map_err(|_| IdeviceError::FfiInvalidString)?;
+    let runner_app_path =
+        CString::new(cfg.runner_app_path).map_err(|_| IdeviceError::FfiInvalidString)?;
+    let runner_app_container =
+        CString::new(cfg.runner_app_container).map_err(|_| IdeviceError::FfiInvalidString)?;
+    let runner_bundle_executable =
+        CString::new(cfg.runner_bundle_executable).map_err(|_| IdeviceError::FfiInvalidString)?;
+
+    Ok(XCTestRunnerMetadata {
+        runner_bundle_id: runner_bundle_id.into_raw(),
+        runner_app_path: runner_app_path.into_raw(),
+        runner_app_container: runner_app_container.into_raw(),
+        runner_bundle_executable: runner_bundle_executable.into_raw(),
+    })
+}
+
+fn abort_and_join(task: JoinHandle<()>) {
+    task.abort();
+    crate::run_sync_local(async move {
+        let _ = task.await;
+    });
+}
+
+unsafe fn required_string(ptr: *const c_char) -> Result<String, IdeviceError> {
+    if ptr.is_null() {
+        return Err(IdeviceError::FfiInvalidArg);
+    }
+    unsafe { CStr::from_ptr(ptr) }
+        .to_str()
+        .map(ToOwned::to_owned)
+        .map_err(|_| IdeviceError::FfiInvalidString)
+}
+
+/// Looks up XCTest runner metadata via InstallationProxy over an existing RSD connection.
+///
+/// # Safety
+/// Pointers must be valid handles allocated by this library. `bundle_id` must be
+/// a valid null-terminated UTF-8 string. `out` must be writable storage.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn xctest_runner_copy_metadata_from_rsd(
+    adapter: *mut AdapterHandle,
+    handshake: *mut RsdHandshakeHandle,
+    bundle_id: *const c_char,
+    out: *mut *mut XCTestRunnerMetadata,
+) -> *mut IdeviceFfiError {
+    if adapter.is_null() || handshake.is_null() || bundle_id.is_null() || out.is_null() {
+        return ffi_err!(IdeviceError::FfiInvalidArg);
+    }
+
+    let bundle_id = match unsafe { required_string(bundle_id) } {
+        Ok(bundle_id) => bundle_id,
+        Err(error) => return ffi_err!(error),
+    };
+    let mut adapter = unsafe { &*adapter }.0.clone();
+    let mut handshake = unsafe { &*handshake }.0.clone();
+
+    let result: Result<TestConfig, IdeviceError> = crate::run_sync_local(async move {
+        let mut install_proxy =
+            InstallationProxyClient::connect_rsd(&mut adapter, &mut handshake).await?;
+        TestConfig::from_installation_proxy(&mut install_proxy, &bundle_id, None).await
+    });
+
+    match result.and_then(metadata_from_config) {
+        Ok(metadata) => {
+            unsafe { *out = Box::into_raw(Box::new(metadata)) };
+            null_mut()
+        }
+        Err(error) => ffi_err!(error),
+    }
+}
+
+unsafe fn optional_string(ptr: *const c_char) -> Result<Option<String>, IdeviceError> {
+    if ptr.is_null() {
+        return Ok(None);
+    }
+    unsafe { CStr::from_ptr(ptr) }
+        .to_str()
+        .map(|value| Some(value.to_owned()))
+        .map_err(|_| IdeviceError::FfiInvalidString)
+}
+
+unsafe fn string_array(
+    strings: *const *const c_char,
+    count: usize,
+) -> Result<Vec<String>, IdeviceError> {
+    if count == 0 {
+        return Ok(Vec::new());
+    }
+    if strings.is_null() {
+        return Err(IdeviceError::FfiInvalidArg);
+    }
+    let raw = unsafe { std::slice::from_raw_parts(strings, count) };
+    raw.iter()
+        .map(|ptr| unsafe { required_string(*ptr) })
+        .collect()
+}
+
+unsafe fn config_from_ffi(config: *const XCTestRunnerConfig) -> Result<TestConfig, IdeviceError> {
+    if config.is_null() {
+        return Err(IdeviceError::FfiInvalidArg);
+    }
+    let config = unsafe { &*config };
+
+    let mut runner_env = Dictionary::new();
+    for entry in unsafe { string_array(config.env_vars, config.env_vars_count) }? {
+        let Some((key, value)) = entry.split_once('=') else {
+            return Err(IdeviceError::FfiInvalidArg);
+        };
+        runner_env.insert(key.to_owned(), Value::String(value.to_owned()));
+    }
+
+    let runner_args = unsafe { string_array(config.arguments, config.arguments_count) }?;
+
+    Ok(TestConfig {
+        runner_bundle_id: unsafe { required_string(config.runner_bundle_id) }?,
+        runner_app_path: unsafe { required_string(config.runner_app_path) }?,
+        runner_app_container: unsafe { required_string(config.runner_app_container) }?,
+        runner_bundle_executable: unsafe { required_string(config.runner_bundle_executable) }?,
+        target_bundle_id: unsafe { optional_string(config.target_bundle_id) }?,
+        target_app_path: unsafe { optional_string(config.target_app_path) }?,
+        target_app_env: None,
+        target_app_args: None,
+        tests_to_run: None,
+        tests_to_skip: None,
+        runner_env: (!runner_env.is_empty()).then_some(runner_env),
+        runner_args: (!runner_args.is_empty()).then_some(runner_args),
+    })
+}
+
+/// Creates an XCTest runner handle from an existing RSD adapter/handshake.
+///
+/// The adapter and handshake are cloned; the caller remains responsible for the
+/// original handles and must keep the underlying tunnel alive.
+///
+/// # Safety
+/// Pointers must be valid handles allocated by this library. `out` must be a
+/// valid pointer to writable storage.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn xctest_runner_new_from_rsd(
+    adapter: *mut AdapterHandle,
+    handshake: *mut RsdHandshakeHandle,
+    ios_major_version: u8,
+    callback: XCTestRunnerStatusCallback,
+    callback_context: *mut c_void,
+    out: *mut *mut XCTestRunnerHandle,
+) -> *mut IdeviceFfiError {
+    if adapter.is_null() || handshake.is_null() || out.is_null() {
+        return ffi_err!(IdeviceError::FfiInvalidArg);
+    }
+    let adapter = unsafe { &*adapter };
+    let handshake = unsafe { &*handshake };
+
+    if let Err(error) = validate_required_rsd_services(&handshake.0) {
+        return ffi_err!(error);
+    }
+
+    let handle = XCTestRunnerHandle {
+        source: idevice::services::dvt::xctest::XCUITestRsdConnection::new(
+            adapter.0.clone(),
+            handshake.0.clone(),
+            ios_major_version,
+        ),
+        state: Arc::new(Mutex::new(XCTestRunnerSharedState {
+            status: XCTestRunnerStatus::RsdReady,
+            first_error_stage: XCTestRunnerStatus::Unknown,
+            error_message: None,
+        })),
+        task: Mutex::new(None),
+        callback,
+        callback_context: callback_context as usize,
+    };
+
+    unsafe { *out = Box::into_raw(Box::new(handle)) };
+    null_mut()
+}
+
+/// Starts the configured preinstalled XCTest runner in the background.
+///
+/// # Safety
+/// `handle` and `config` must be valid pointers.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn xctest_runner_start(
+    handle: *mut XCTestRunnerHandle,
+    config: *const XCTestRunnerConfig,
+    timeout_seconds: f64,
+) -> *mut IdeviceFfiError {
+    if handle.is_null() || config.is_null() {
+        return ffi_err!(IdeviceError::FfiInvalidArg);
+    }
+    let handle_ref = unsafe { &*handle };
+    let cfg = match unsafe { config_from_ffi(config) } {
+        Ok(cfg) => cfg,
+        Err(error) => return ffi_err!(error),
+    };
+
+    let mut task = handle_ref.task.lock().expect("xctest runner task poisoned");
+    if task.as_ref().is_some_and(|task| !task.is_finished()) {
+        return ffi_err!(IdeviceError::UnknownErrorType(
+            "xctest runner is already running".into(),
+        ));
+    }
+
+    let source = handle_ref.source.clone();
+    let state = handle_ref.state.clone();
+    let callback = handle_ref.callback;
+    let callback_context = handle_ref.callback_context;
+    let timeout = (timeout_seconds > 0.0).then(|| Duration::from_secs_f64(timeout_seconds));
+
+    *task = Some(crate::GLOBAL_RUNTIME.handle().spawn(async move {
+        let service = XCUITestService::from_rsd(
+            source.adapter(),
+            source.handshake(),
+            source.ios_major_version(),
+        );
+        let mut listener = FfiXCTestListener;
+        let mut stage_listener = FfiXCTestStageListener {
+            state: state.clone(),
+            callback,
+            callback_context,
+        };
+        if let Err(error) = service
+            .run_with_stage_listener(cfg, &mut listener, timeout, &mut stage_listener)
+            .await
+        {
+            set_failure(&state, callback, callback_context, error);
+        }
+    }));
+
+    null_mut()
+}
+
+/// Stops the background XCTest session task and drops its DTX connections.
+///
+/// # Safety
+/// `handle` must be a valid pointer or NULL.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn xctest_runner_stop(
+    handle: *mut XCTestRunnerHandle,
+) -> *mut IdeviceFfiError {
+    if handle.is_null() {
+        return ffi_err!(IdeviceError::FfiInvalidArg);
+    }
+    let handle_ref = unsafe { &*handle };
+    if let Some(task) = handle_ref
+        .task
+        .lock()
+        .expect("xctest runner task poisoned")
+        .take()
+    {
+        abort_and_join(task);
+    }
+    {
+        let mut state = handle_ref
+            .state
+            .lock()
+            .expect("xctest runner state poisoned");
+        state.status = XCTestRunnerStatus::Finished;
+    }
+    notify(
+        handle_ref.callback,
+        handle_ref.callback_context,
+        XCTestRunnerStatus::Finished,
+        Some("stopped"),
+    );
+    null_mut()
+}
+
+/// Gets the current runner status and first failing stage, if any.
+///
+/// # Safety
+/// Pointers must be valid and non-null.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn xctest_runner_get_status(
+    handle: *mut XCTestRunnerHandle,
+    status_out: *mut XCTestRunnerStatus,
+    first_error_stage_out: *mut XCTestRunnerStatus,
+) -> *mut IdeviceFfiError {
+    if handle.is_null() || status_out.is_null() || first_error_stage_out.is_null() {
+        return ffi_err!(IdeviceError::FfiInvalidArg);
+    }
+    let handle_ref = unsafe { &*handle };
+    let state = handle_ref
+        .state
+        .lock()
+        .expect("xctest runner state poisoned");
+    unsafe {
+        *status_out = state.status;
+        *first_error_stage_out = state.first_error_stage;
+    }
+    null_mut()
+}
+
+/// Copies the current error message. Caller frees the returned string with
+/// `xctest_runner_string_free`.
+///
+/// # Safety
+/// `handle` must be valid. Returns NULL when no error has been recorded.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn xctest_runner_copy_error_message(
+    handle: *mut XCTestRunnerHandle,
+) -> *mut c_char {
+    if handle.is_null() {
+        return null_mut();
+    }
+    let handle_ref = unsafe { &*handle };
+    let state = handle_ref
+        .state
+        .lock()
+        .expect("xctest runner state poisoned");
+    let Some(message) = state.error_message.as_ref() else {
+        return null_mut();
+    };
+    CString::new(message.as_str())
+        .unwrap_or_else(|_| CString::new("invalid error message").unwrap())
+        .into_raw()
+}
+
+/// Frees a string returned by XCTest FFI.
+///
+/// # Safety
+/// `string` must be NULL or a string allocated by this library.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn xctest_runner_string_free(string: *mut c_char) {
+    if !string.is_null() {
+        let _ = unsafe { CString::from_raw(string) };
+    }
+}
+
+/// Frees metadata returned by `xctest_runner_copy_metadata_from_rsd`.
+///
+/// # Safety
+/// `metadata` must be NULL or a metadata pointer allocated by this library.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn xctest_runner_metadata_free(metadata: *mut XCTestRunnerMetadata) {
+    if !metadata.is_null() {
+        let metadata = unsafe { Box::from_raw(metadata) };
+        unsafe {
+            xctest_runner_string_free(metadata.runner_bundle_id);
+            xctest_runner_string_free(metadata.runner_app_path);
+            xctest_runner_string_free(metadata.runner_app_container);
+            xctest_runner_string_free(metadata.runner_bundle_executable);
+        }
+    }
+}
+
+/// Frees an XCTest runner handle.
+///
+/// # Safety
+/// `handle` must be NULL or a handle allocated by this library.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn xctest_runner_free(handle: *mut XCTestRunnerHandle) {
+    if !handle.is_null() {
+        if let Some(task) = unsafe { &*handle }
+            .task
+            .lock()
+            .expect("xctest runner task poisoned")
+            .take()
+        {
+            abort_and_join(task);
+        }
+        let _ = unsafe { Box::from_raw(handle) };
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{XCTestRunnerStatus, next_error_stage};
+
+    #[test]
+    fn status_failures_point_to_next_startup_stage() {
+        assert_eq!(
+            next_error_stage(XCTestRunnerStatus::RsdReady),
+            XCTestRunnerStatus::TestmanagerControlReady
+        );
+        assert_eq!(
+            next_error_stage(XCTestRunnerStatus::TestmanagerMainReady),
+            XCTestRunnerStatus::DvtReady
+        );
+        assert_eq!(
+            next_error_stage(XCTestRunnerStatus::PidAuthorized),
+            XCTestRunnerStatus::XctestHandshakeReady
+        );
+    }
+}
