+/// Verifies that a supplied RSD handshake advertises the XCTest services needed
+/// for iOS 17+ orchestration.
+pub fn validate_required_rsd_services(handshake: &RsdHandshake) -> Result<(), IdeviceError> {
+    for service_name in [
+        TESTMANAGERD_RSD_SERVICE,
+        "com.apple.instruments.dtservicehub",
+    ] {
+        if !handshake.services.contains_key(service_name) {
+            warn!("RSD service not found: {}", service_name);
+            return Err(IdeviceError::ServiceNotFound);
+        }
+    }
+    Ok(())
+}
