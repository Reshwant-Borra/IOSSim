#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

find_bootstrap_python() {
  local candidate
  for candidate in python3.13 python3.12 python3.11 python3 python; do
    if command -v "${candidate}" >/dev/null 2>&1; then
      if "${candidate}" - <<'PY' >/dev/null 2>&1
import sys
raise SystemExit(0 if sys.version_info >= (3, 9) else 1)
PY
      then
        command -v "${candidate}"
        return 0
      fi
    fi
  done
  return 1
}

PYTHON_BIN="$(find_bootstrap_python || true)"
if [[ -z "${PYTHON_BIN}" ]]; then
  echo "[ACTION] Python 3.9+ is required to run the IOSSim setup CLI."
  echo "Install Xcode Command Line Tools or Python 3.11+, then rerun: ./iossim setup"
  exit 2
fi

exec "${PYTHON_BIN}" "${ROOT_DIR}/scripts/bootstrap/iossim_cli.py" "$@"
